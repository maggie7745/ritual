# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real keys.

# --- Supabase (recommended) ---
# Project Settings -> API in your Supabase dashboard.
# The anon key is meant to be public in client code; it can only do what
# your Row Level Security policies allow (see web/README.md).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- OR: a generic endpoint instead of Supabase ---
# Any URL that accepts POST { "email": "..." } as JSON.
# VITE_WAITLIST_ENDPOINT=https://your-endpoint.example/subscribe
